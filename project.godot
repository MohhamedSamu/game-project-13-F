; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project-13-f"
run/main_scene="uid://cke50ywqyobsp"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
InputHints="*res://scripts/autoload/input_hints.gd"
GamepadUINav="*res://scripts/ui/gamepad_ui_nav.gd"
UISFX="*res://scripts/autoload/ui_sfx.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
MusicDirector="*res://scripts/autoload/music_director.gd"
DialogueController="*res://scripts/autoload/dialogue_controller.gd"
Scene1PoliceDirector="*res://scripts/narrative/scene1_police_director.gd"
Scene4BathroomExitDirector="*res://scripts/narrative/scene4_bathroom_exit_director.gd"
Scene6FinalChaseDirector="*res://scripts/narrative/scene6_final_chase_director.gd"
Scene6FinalDeathDirector="*res://scripts/narrative/scene6_final_death_director.gd"
InnerThoughts="*res://scenes/ui/inner_thoughts_overlay.tscn"
InstructionsOverlay="*res://scenes/ui/instructions_overlay.tscn"
DevOverlay="*res://scenes/ui/dev_overlay.tscn"

[dialogue_manager]

runtime/balloon_path="res://scenes/dialogue/balloon.tscn"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

interactable=""
interactable_ray_target=""
pickup=""
player=""
interaction_crosshair=""

