[dialogue_manager]

runtime/balloon_path="res://scenes/dialogue/balloon.tscn"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[filesystem]

import/blender/enabled=false

